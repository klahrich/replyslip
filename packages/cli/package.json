  "license": "Apache-2.0",
  "author": "ClaireVue",
  "homepage": "https://valetto.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klahrich/replyslip.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/klahrich/replyslip/issues"
  },
  "keywords": [
    "replyslip",
    "mcp",
    "ai-agents",
    "agent",
    "claude-code",
    "codex",
    "async",
    "tasks",
    "cli",
    "agent-to-agent",
    "multi-agent",
    "model-context-protocol",
    "json-schema"
  ],
  "type": "module",
  "bin": {
    "replyslip": "replyslip.mjs"
  },
  "files": [
