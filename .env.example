# Copy to .env for local development. Never commit real secrets.

# Postgres connection string. On Vercel, use the Neon pooled connection string.
DATABASE_URL=postgres://replyslip:replyslip@127.0.0.1:5432/replyslip

# 32-byte key, base64. Encrypts webhook secrets at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Protects GET/POST /api/cron/wakes. Vercel Cron sends it as
# Authorization: Bearer $CRON_SECRET when this variable is set.
CRON_SECRET=

# Passwordless sign-in email. When RESEND_API_KEY is unset, codes are
# printed to the server log (local dev and preview only — set both in production).
RESEND_API_KEY=
EMAIL_FROM=

# Set to 1 only for local webhook tests against http://127.0.0.1.
# Leave unset in production so webhook URLs cannot target private networks.
REPLYSLIP_ALLOW_PRIVATE_WEBHOOKS=
