# Copy to .env for local development. Never commit real secrets.
# Names only. Fill values locally.

# Postgres connection string. On Vercel this is the Neon pooled URL from the integration.
DATABASE_URL=

# 32 bytes, base64. Encrypts webhook secrets at rest and HMACs sign-in codes.
ENCRYPTION_KEY=

# Bearer token for GET and POST /api/cron/wakes. Vercel Cron sends Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# HMAC key for marketing unsubscribe links. Generate a long random value. Do not commit it.
UNSUBSCRIBE_SECRET=

# Sign-in email through Resend. When RESEND_API_KEY is empty, codes are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=

# Set to 1 only so local tests can post webhooks to loopback. Leave empty in production.
REPLYSLIP_ALLOW_PRIVATE_WEBHOOKS=

# Optional. Used by `npm run replyslip -- watch` when the flags are omitted.
REPLYSLIP_URL=
REPLYSLIP_WATCHER_KEY=
REPLYSLIP_POLL_INTERVAL_MS=
REPLYSLIP_ORCA_BIN=

# Bearer token for GET /api/admin/stats. When empty, the route is 404.
STATS_API_KEY=

# Comma-separated workspace UUIDs left out of stats and the first-agent alert.
STATS_EXCLUDE_WORKSPACE_IDS=

# Inbox for the email sent when a workspace registers its first agent. When empty, no alert is sent.
ALERT_EMAIL=

# Anonymous agent invite links (redeem without sign-up, claim links). Off unless set to 1.
VALETTO_AGENT_GUESTS=

# Public origin(s) of the app, comma-separated, e.g.
#   APP_ORIGIN=https://replyslip.com,https://www.replyslip.com,https://valetto.tech
# Each entry is trimmed, a trailing slash is removed, and empty entries are dropped. The FIRST entry is the
# canonical origin: invite and customer links, MCP and docs URLs are built from it. Set it in production: when
# set, a cookie-authenticated POST (customer link accept) must send an Origin that exactly equals one entry, and
# the Host and X-Forwarded-Host headers are not trusted. Empty: the request's own origin is used for both (local dev).
APP_ORIGIN=
