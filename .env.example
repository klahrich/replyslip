# Copy to .env for local development. Never commit real secrets.
# Names only. Fill values locally.

# Postgres connection string. On Vercel this is the Neon pooled URL from the integration.
DATABASE_URL=

# 32 bytes, base64. Encrypts webhook secrets at rest and HMACs sign-in codes.
ENCRYPTION_KEY=

# Bearer token for GET and POST /api/cron/wakes. Vercel Cron sends Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# HMAC key for marketing unsubscribe links. Generate a long random value. Do not commit it.
UNSUBSCRIBE_SECRET=

# Sign-in email through Resend. When RESEND_API_KEY is empty, codes are printed to the server log, except in
# production (VERCEL_ENV=production, or NODE_ENV=production off Vercel), where every send fails instead.
RESEND_API_KEY=
EMAIL_FROM=

# Set to 1 only so local tests can post webhooks to loopback. Leave empty in production.
REPLYSLIP_ALLOW_PRIVATE_WEBHOOKS=

# Optional. Used by `npm run replyslip -- watch` when the flags are omitted.
REPLYSLIP_URL=
REPLYSLIP_WATCHER_KEY=
REPLYSLIP_POLL_INTERVAL_MS=
REPLYSLIP_ORCA_BIN=

# Bearer token for GET /api/admin/stats. When empty, the route is 404.
STATS_API_KEY=

# Comma-separated workspace UUIDs left out of stats and the first-agent alert.
STATS_EXCLUDE_WORKSPACE_IDS=

# Inbox for the email sent when a workspace registers its first agent. When empty, no alert is sent.
ALERT_EMAIL=

# Anonymous agent invite links (redeem without sign-up, claim links). Off unless set to 1.
VALETTO_AGENT_GUESTS=

# Public origin(s) of the app, comma-separated, e.g.
#   APP_ORIGIN=https://replyslip.com,https://www.replyslip.com,https://valetto.tech
# Each entry is trimmed, a trailing slash is removed, and empty entries and a literal "null" are dropped. Every
# other entry must be an exact origin (lowercase scheme://host[:port], no path, no default port such as :443);
# anything else fails at server start with an error naming the fix. The FIRST entry is the canonical origin:
# invite and customer links, MCP and docs URLs, and served docs are built from it. Set it in production: when
# set, a cookie-authenticated POST (customer link accept) must send an Origin that exactly equals one entry, and
# the Host and X-Forwarded-Host headers are not trusted. Empty: the request's own origin is used for both (local
# dev); in production that logs a warning once.
APP_ORIGIN=

# Valetto early access (POST /api/valetto/early-access) accepts an Origin from the APP_ORIGIN list above, e.g.
# https://valetto.tech when the site is served on its own domain. Notices go to karim@valetto.tech through
# RESEND_API_KEY and EMAIL_FROM, with the submitter as Reply-To (one plain ASCII address, validated strictly).
# Without RESEND_API_KEY in production the request returns 500 rather than logging the notice.

# Valetto site assistant demo (/s/demo/<token>, /api/v1/s/*). Off (404) unless set to 1.
VALETTO_SITE_ASSISTANT=
# OpenAI API key for the demo's answers. Empty: typed questions go to the fixed "check with the team" reply and
# the import script skips pre-generating suggested answers.
SITE_LLM_API_KEY=
# Model for the Responses API call. Default gpt-6-luna.
SITE_LLM_MODEL=
# Tried once, within the same caps, when the main model is not found or returns a 5xx. Default gpt-6.1-terra;
# "off" turns the retry off. The fallback is reserved and charged at its own prices, in USD per million
# input / output tokens. There is no default price: until both are set, the fallback is never called.
SITE_LLM_FALLBACK_MODEL=
SITE_LLM_FALLBACK_PRICE_IN_PER_M=
SITE_LLM_FALLBACK_PRICE_OUT_PER_M=
# Optional tuning. Defaults: max output tokens 800, reasoning effort none ("off" omits the field), timeout
# 20000 ms, prices $0.10 / $0.50 per million input / output tokens, global cap $5 per UTC day.
SITE_LLM_MAX_OUTPUT_TOKENS=
SITE_LLM_REASONING_EFFORT=
SITE_LLM_TIMEOUT_MS=
SITE_LLM_PRICE_IN_PER_M=
SITE_LLM_PRICE_OUT_PER_M=
SITE_DAILY_COST_CAP_USD=
# Daily messages per IP (stored only as a keyed hash) on one demo link, and across all demo links. Defaults 20, 40.
SITE_IP_DAILY_MESSAGES_PER_LINK=
SITE_IP_DAILY_MESSAGES=
# Base URL written into demo links by scripts/site-demo-import.ts. Default https://valetto.tech.
SITE_DEMO_BASE_URL=
